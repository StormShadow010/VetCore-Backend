# ============================================================
# .gitignore — Backend Node.js + TypeScript
# ============================================================

# ─── Dependencias ───────────────────────────────────────────
node_modules/

# ─── Build / Compilado ───────────────────────────────────────
dist/
build/
out/

# ─── TypeScript ──────────────────────────────────────────────
*.tsbuildinfo
*.js.map

# ─── Variables de entorno ────────────────────────────────────
.env
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── Testing y cobertura ─────────────────────────────────────
coverage/
.nyc_output/

# ─── Caché ───────────────────────────────────────────────────
.eslintcache
.tsbuildinfo
.cache/

# ─── Uploads / archivos generados en runtime ─────────────────
uploads/
tmp/
temp/

# ─── IDEs y editores ─────────────────────────────────────────
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Sistema operativo ───────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Misc ────────────────────────────────────────────────────
*.local
*.pem
*.key
*.cert